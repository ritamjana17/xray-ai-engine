# ─────────────────────────────────────────────
#  X-ray Analyzer – Environment variables
# ─────────────────────────────────────────────
#
# 1. Copy this file to .env.local  (never commit that file)
# 2. Paste your key from https://aistudio.google.com/app/apikey
# 3. Do NOT add a billing account – the free tier is enough
#
GEMINI_API_KEY=your_api_key_here

# Optional: tighten IP rate-limiting window (milliseconds, default 60000)
# RATE_LIMIT_WINDOW_MS=60000

# Optional: max requests per IP per window (default 5)
# RATE_LIMIT_MAX=5
